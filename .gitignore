mvp/secrets.local.json
**/secrets.local.*

# Inbox drop folder (runtime CSVs from the .bat, processed files, logs)
mvp/inbox/
mvp/inbox_challan/
skill-observations/

# operator register photos (stored locally, not versioned)
mvp/program_scans/
